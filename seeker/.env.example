# SQLite database (relative to prisma/ directory)
DATABASE_URL="file:./dev.db"

# Anthropic API key — add yours to enable real LLM features.
# Without it, Seeker runs in heuristic fallback mode (a banner shows in the UI).
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional: override the model used for LLM features (default: claude-opus-4-8)
# SEEKER_MODEL="claude-opus-4-8"

# Optional: force heuristic mode even when a key is present
# SEEKER_LLM="off"
